# أكلني | Eklni — environment variables. Secrets (GOOGLE_CLIENT_SECRET, NOTIFY_WEBHOOK_TOKEN) go in the server environment, never in the code or the repository.
PORT=3000
# Path to the SQLite database file (contains health data — keep it on an encrypted disk)
EKLNI_DB=./eklni.db
# Time zone used to decide "today"
APP_TZ=Africa/Cairo
# Set to 1 when served over HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=0
# Monthly subscription
# Free trial length for new accounts (days). 0 = no trial: new accounts are locked until activated.
EKLNI_TRIAL_DAYS=7
# Platform owners are granted from the server console only:  npm run owner -- grant owner@example.com
# Max registrations per client address per hour
EKLNI_REGISTER_LIMIT=20
# Behind a reverse proxy: use X-Forwarded-For for throttling
TRUST_PROXY=0
# estimates | reviewed_only  (reviewed_only refuses to build plans from unreviewed food values)
EKLNI_FOOD_DATA_MODE=estimates
# Backups (npm run backup) — put this on an encrypted volume and copy off-site
EKLNI_BACKUP_DIR=./backups
EKLNI_BACKUP_KEEP=14
# Notifications: 0 disables the scheduler. External forwarding only with an https gateway + user opt-in.
EKLNI_NOTIFICATIONS=1
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
# CSRF: extra trusted origins (https://host, comma-separated); same-origin is always allowed
EKLNI_ALLOWED_ORIGINS=
# Public base URL (https://…) used in password-reset / verification / share links and the Google redirect URI
EKLNI_PUBLIC_URL=
# Sign in with Google (optional). Create an OAuth client "Web application" in Google Cloud Console and register
# the redirect URI  <EKLNI_PUBLIC_URL>/api/auth/google/callback . Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 only after confirming disk encryption (SECURITY_PLAN.md §3) — an attestation, not a check
EKLNI_DISK_ENCRYPTION_CONFIRMED=0
# NODE_ENV=production makes the server refuse unsafe settings (see npm run check-config)
NODE_ENV=
# Real PDF download of the nutrition file (selectable Arabic text). Path to chromium / chrome / headless_shell.
# Without it the PDF is built in the user's browser (pages as images). Set NO_SANDBOX=1 only when running as root in a container.
EKLNI_CHROMIUM=
EKLNI_CHROMIUM_NO_SANDBOX=0
# Shown on the lock screen (optional)
EKLNI_PRICE_EGP=
EKLNI_PAYMENT_NOTE=
